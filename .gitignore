# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LYON - generated / local data
/prisma/*.db
/prisma/*.db-journal
/public/uploads/*
!/public/uploads/.gitkeep
/public/fonts/*
!/public/fonts/.gitkeep
/public/brand/*
!/public/brand/.gitkeep
/src/app/fonts.css
/src/generated/assets.json

# .env იგნორირებულია, მაგრამ ნიმუში რეპოზიტორიაში რჩება
!.env.example

# Claude Code-ის ლოკალური პარამეტრები
.claude/settings.local.json

# Vercel / ინტეგრაციების ლოკალური ფაილები
.agents/
skills-lock.json

# Neon/Vercel ინტეგრაციის სკილები (ლოკალური)
.claude/skills/
