// LYON - ფეხსაცმლის მაღაზიის მონაცემთა ბაზა (SQLite)
// ფასები ინახება თეთრებში (1 ლარი = 100), მთელი რიცხვებით.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- ადმინი / სესიები ----------

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------- კატალოგი ----------

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nameKa    String
  nameEn    String
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  logoUrl  String?
  products Product[]
}

model Product {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  nameKa        String
  nameEn        String
  descriptionKa String         @default("")
  descriptionEn String         @default("")
  brandId       Int?
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId    Int?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType   String?
  price         Int
  salePrice     Int?
  isNew         Boolean        @default(false)
  isBestSeller  Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]
  colors        ProductColor[]
  sizes         ProductSize[]
  orderItems    OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductColor {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameKa    String
  nameEn    String
  hex       String
  sortOrder Int     @default(0)
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)
  sortOrder Int     @default(0)

  @@unique([productId, size])
}

// ---------- შეკვეთები ----------

model Order {
  id           Int         @id @default(autoincrement())
  number       String      @unique
  accessToken  String      @unique
  status       String      @default("new")
  customerName String
  phone        String
  city         String
  address      String
  comment      String?
  subtotal     Int
  discount     Int         @default(0)
  promoCode    String?
  shipping     Int         @default(0)
  total        Int
  lang         String      @default("ka")
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  slug      String?
  size      String
  color     String?
  imageUrl  String?
  qty       Int
  unitPrice Int
  lineTotal Int
}

// ---------- ფასდაკლებები ----------

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  value       Int
  minSubtotal Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Promotion {
  id          Int       @id @default(autoincrement())
  titleKa     String
  titleEn     String
  percent     Int
  scope       String
  categoryId  Int?
  brandId     Int?
  productType String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ---------- კონტენტი / პარამეტრები ----------

model SiteContent {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
