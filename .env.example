# ---------- ბაზა ----------
# ლოკალურად და VPS-ზე: SQLite ფაილი (prisma/dev.db)
DATABASE_URL="file:./dev.db"
# Vercel-ზე: Neon Postgres — ცვლადს თავად Vercel ამატებს (Storage -> Neon).
# DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
#
# provider (sqlite/postgresql) ავტომატურად ირჩევა DATABASE_URL-იდან:
# იხ. scripts/prisma-schema.mjs

# ---------- ადმინი ----------
# გამოიყენება მხოლოდ პირველი seed-ისას. თუ ცარიელია, პაროლი შემთხვევით
# დაგენერირდება და seed-ის ლოგში ერთხელ დაიბეჭდება.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ---------- საიტი ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- ფოტოების ატვირთვა ----------
# Vercel-ზე ფაილური სისტემა მხოლოდ წასაკითხია, ამიტომ ფოტოები Vercel Blob-ში ინახება.
# ცვლადს თავად Vercel ამატებს (Storage -> Blob). ლოკალურად საჭირო არ არის —
# ფოტოები public/uploads/-ში შეინახება.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"
